RESEND_API_KEY=
EMAIL_EXPEDITEUR=Site Horizon Comptable <site@horizoncomptable.com>
EMAIL_DESTINATAIRE=contact@horizoncomptable.com

# Clés de TEST officielles de Cloudflare (toujours valides) ; à remplacer par les vraies en production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
