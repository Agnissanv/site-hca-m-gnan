---
import Base from "../layouts/Base.astro";
import { cabinet, lienWhatsApp, lien } from "../config";
---
<Base
  titre="Contact et rendez-vous"
  description="Contactez le cabinet Horizon Comptable Afrique à Abidjan : rendez-vous, WhatsApp ou formulaire. Réponse rapide."
>
  <section class="page-tete">
    <div class="conteneur">
      <p class="etiquette">Contact</p>
      <h1>Parlons de votre situation.</h1>
      <p class="chapeau">Une question, un retard de déclarations, un projet de création : écrivez-nous, nous revenons vers vous rapidement.</p>
    </div>
  </section>

  <section class="bande">
    <div class="conteneur contact">
      <aside class="moyens" aria-label="Nous joindre directement">
        <div class="moyen">
          <p class="etiquette">WhatsApp et téléphone</p>
          <p><a class:list={["detail", { provisoire: cabinet.numeroProvisoire }]} href={lienWhatsApp()} target="_blank" rel="noopener">{cabinet.telephone}</a></p>
        </div>
        <div class="moyen">
          <p class="etiquette">Par e-mail</p>
          <p><a href={`mailto:${cabinet.email}`}>{cabinet.email}</a></p>
        </div>
        <div class="moyen">
          <p class="etiquette">Où nous rencontrer</p>
          <p>Abidjan, et partout en Côte d'Ivoire : en rendez-vous, par téléphone ou en visioconférence.</p>
        </div>
      </aside>

      <form id="rendez-vous" class="formulaire" novalidate>
        <fieldset class="type">
          <legend>Votre demande</legend>
          <label><input type="radio" name="type" value="question" checked /> Poser une question</label>
          <label><input type="radio" name="type" value="rendez-vous" /> Demander un rendez-vous</label>
        </fieldset>

        <div class="champs">
          <label><span>Nom et prénoms <span class="requis" aria-hidden="true">*</span></span>
            <input name="nom" type="text" autocomplete="name" required />
          </label>
          <label>Entreprise
            <input name="entreprise" type="text" autocomplete="organization" />
          </label>
          <label><span>Téléphone ou WhatsApp <span class="requis" aria-hidden="true">*</span></span>
            <input name="telephone" type="tel" autocomplete="tel" placeholder="+225 …" required />
          </label>
          <label>E-mail
            <input name="email" type="email" autocomplete="email" />
          </label>
        </div>

        <div class="champs rdv" hidden>
          <label>Date souhaitée
            <input name="date" type="date" />
          </label>
          <label>Moment de la journée
            <select name="moment">
              <option>Matin</option>
              <option>Après-midi</option>
            </select>
          </label>
          <label class="large">Format
            <select name="format">
              <option>Rendez-vous en personne (lieu à convenir)</option>
              <option>Appel téléphonique</option>
              <option>Visioconférence</option>
            </select>
          </label>
        </div>

        <label class="large"><span>Votre message <span class="requis" aria-hidden="true">*</span></span>
          <textarea name="message" rows="5" required placeholder="Votre activité, votre besoin, vos délais…"></textarea>
        </label>

        <label class="accord">
          <input type="checkbox" name="accord" required />
          <span>J'accepte que ces informations soient utilisées pour répondre à ma demande (voir la <a href={lien("/mentions-legales#donnees")}>politique de confidentialité</a>).</span>
        </label>

        <p class="etat" role="status" aria-live="polite"></p>
        <button class="bouton bouton-plein envoyer" type="submit">Envoyer ma question</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .moyens { display: grid; gap: 30px; }
  .moyen { border-top: 3px solid var(--ebene); padding-top: 16px; }
  .moyen .etiquette { margin-bottom: 12px; }
  .moyen p { margin: 0; }
  .detail { font: 500 1rem/1.4 var(--f-mono); display: inline-block; margin-top: 12px; }

  .formulaire { background: var(--papier); border-radius: 16px; padding: clamp(22px, 4vw, 40px); display: grid; gap: 22px; }
  .type { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .type legend { font: 500 0.75rem/1.4 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--brun); margin-bottom: 12px; }
  .type label {
    display: flex; gap: 10px; align-items: center; cursor: pointer;
    font: 600 1rem/1 var(--f-display); padding: 14px 16px; border: 1.5px solid var(--trait); border-radius: var(--rayon); background: #fff;
  }
  .type label:has(input:checked) { border-color: var(--olive); background: color-mix(in srgb, var(--olive) 8%, #fff); }
  .type input { accent-color: var(--olive); width: 18px; height: 18px; }

  .champs { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .champs[hidden] { display: none; }
  label { display: grid; gap: 8px; font: 600 0.95rem/1.2 var(--f-display); }
  .requis { color: var(--olive); }
  .large { grid-column: 1 / -1; }
  input, select, textarea {
    font: 400 1rem/1.4 var(--f-texte); color: var(--ebene);
    padding: 12px 14px; border: 1.5px solid var(--trait); border-radius: var(--rayon); background: #fff; width: 100%;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--olive); box-shadow: 0 0 0 3px color-mix(in srgb, var(--soleil) 45%, transparent); }
  [aria-invalid="true"] { border-color: #8A5A00; }
  .accord { display: flex; gap: 12px; align-items: flex-start; font: 400 0.95rem/1.45 var(--f-texte); }
  .accord input { width: 20px; height: 20px; flex: none; margin-top: 2px; accent-color: var(--olive); }
  .etat { margin: 0; font-size: 0.98rem; }
  .etat:empty { display: none; }
  .etat.erreur { color: #7A4A00; font-weight: 600; }
  .etat.info { background: var(--sable); padding: 12px 14px; border-radius: var(--rayon); }
  .envoyer { justify-self: start; }

  @media (max-width: 860px) {
    .contact { grid-template-columns: 1fr; }
    .formulaire { order: -1; }
  }
  @media (max-width: 560px) { .champs { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById("rendez-vous") as HTMLFormElement;
  const blocRdv = form.querySelector<HTMLElement>(".rdv")!;
  const envoyer = form.querySelector<HTMLButtonElement>(".envoyer")!;
  const etat = form.querySelector<HTMLElement>(".etat")!;

  function majType() {
    const rdv = (form.elements.namedItem("type") as RadioNodeList).value === "rendez-vous";
    blocRdv.hidden = !rdv;
    envoyer.textContent = rdv ? "Demander le rendez-vous" : "Envoyer ma question";
  }
  form.querySelectorAll<HTMLInputElement>('input[name="type"]').forEach((r) => r.addEventListener("change", majType));
  if (location.hash === "#rendez-vous") {
    (form.querySelector('input[value="rendez-vous"]') as HTMLInputElement).checked = true;
  }
  majType();

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    etat.className = "etat";
    const manquants = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]")].filter((c) =>
      c.type === "checkbox" ? !(c as HTMLInputElement).checked : !c.value.trim()
    );
    form.querySelectorAll("[aria-invalid]").forEach((c) => c.removeAttribute("aria-invalid"));
    if (manquants.length) {
      manquants.forEach((c) => c.setAttribute("aria-invalid", "true"));
      etat.classList.add("erreur");
      etat.textContent = "Complétez les champs marqués d'une étoile et cochez la case d'accord pour envoyer votre demande.";
      manquants[0].focus();
      return;
    }
    envoyer.disabled = true;
    try {
      const r = await fetch(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/api/contact`, { method: "POST", body: new FormData(form) });
      if (!r.ok) throw new Error(String(r.status));
      etat.classList.add("info");
      etat.textContent = "Demande envoyée. Le cabinet vous répond rapidement, par téléphone ou par e-mail.";
      form.reset();
      majType();
    } catch {
      etat.classList.add("info");
      etat.textContent = "Maquette : l'envoi du formulaire sera activé à la mise en ligne. En attendant, écrivez-nous sur WhatsApp.";
    } finally {
      envoyer.disabled = false;
    }
  });
</script>
