---
import Base from "../layouts/Base.astro";
import CompteEnT from "../components/CompteEnT.astro";
import { url, type Langue } from "../i18n";

interface Props { langue: Langue }
const { langue } = Astro.props;

// Photo du héros : bureau de comptable (graphiques financiers, calculatrice, carnet, ordinateur),
// par Jakub Żerdzicki (licence Unsplash, usage commercial gratuit). https://unsplash.com/photos/heiYgqp0Tsk
// Objectif : que le visiteur comprenne le métier du cabinet en moins de 5 secondes.
// Maquette : servie par le CDN d'Unsplash ; à héberger sur le site à la mise en ligne définitive.
// Les tons chauds (sépia, saturation, exposition) sont appliqués par le serveur d'images, pas en CSS.
const photoHero = (largeur: number) =>
  `https://images.unsplash.com/photo-1707157284454-553ef0a4ed0d?auto=format&fit=crop&w=${largeur}&q=72&sepia=40&sat=-15&exp=6`;

const textes = {
  fr: {
    titre: "Accueil",
    description: "Cabinet comptable à Abidjan : comptabilité SYSCOHADA, déclarations fiscales et sociales, paie, FNE et conseil financier pour les PME et les entrepreneurs de Côte d'Ivoire.",
    etiquette: "Cabinet comptable · Abidjan",
    titreHero: "Votre comptabilité en règle, votre horizon dégagé.",
    chapeau: "Comptabilité conforme au SYSCOHADA, déclarations fiscales et sociales, paie, conseil financier : nous accompagnons les PME et les entrepreneurs de Côte d'Ivoire pour qu'ils se consacrent à leur activité.",
    ariaCompte: "Ce que nous réglons pour vous",
    servicesEtiquette: "Nos services",
    servicesTitre: "Ce que nous prenons en charge",
    services: [
      { titre: "Comptabilité et fiscalité", texte: "Tenue de votre comptabilité selon le SYSCOHADA, états financiers annuels et déclarations fiscales." },
      { titre: "Paie et gestion sociale", texte: "Bulletins de paie, cotisations et déclarations CNPS, suivi de vos obligations d'employeur." },
      { titre: "Conseil et gestion financière", texte: "Trésorerie, rentabilité, maîtrise des charges et préparation de vos dossiers de financement." },
      { titre: "Audit et contrôle", texte: "Revue de vos comptes et de vos procédures, préparation sereine d'un contrôle fiscal." },
      { titre: "Création d'entreprise", texte: "Choix de la forme juridique, formalités de création et premiers pas administratifs." },
      { titre: "Digitalisation et FNE", texte: "Mise en place de la facture normalisée électronique et de vos outils de gestion." },
    ],
    servicesLien: "Le détail de nos services",
    methodeEtiquette: "Notre méthode",
    methodeTitre: "De la première rencontre au suivi mensuel",
    methodeChapeau: "Que votre comptabilité soit à jour ou en retard de plusieurs mois, le chemin est le même.",
    etapes: [
      { titre: "Un premier échange", texte: "Vous nous exposez votre situation, en rendez-vous, par téléphone ou sur WhatsApp." },
      { titre: "Un état des lieux", texte: "Nous examinons vos documents et repérons ce qui doit être régularisé." },
      { titre: "La mise en ordre", texte: "Comptabilité reprise, déclarations régularisées, outils mis en place." },
      { titre: "Un suivi dans la durée", texte: "Déclarations à l'heure, chiffres suivis chaque mois, conseils pour décider." },
    ],
    engagementsEtiquette: "Nos engagements",
    engagementsTitre: "Ce sur quoi vous pouvez compter",
    engagements: [
      { titre: "Conformité", texte: "Vos comptes tenus selon le SYSCOHADA, le référentiel comptable de l'espace OHADA." },
      { titre: "Confidentialité", texte: "Vos chiffres et vos documents ne sortent pas du cabinet." },
      { titre: "Expérience", texte: "Plus de 20 ans d'expérience cumulée de nos associés.", provisoire: true },
      { titre: "Proximité", texte: "Un interlocuteur qui vous répond, y compris sur WhatsApp." },
    ],
    questionsEtiquette: "Vos questions",
    questionsTitre: "Celles qu'on nous pose le plus souvent",
    questionsChapeau: "Touchez une question : notre assistant vous donne une première réponse, le cabinet prend le relais pour votre cas précis.",
    questions: [
      "Qu'est-ce que la facture normalisée électronique (FNE) ?",
      "Comment me mettre en règle avec la DGI et la CNPS ?",
      "Quelles démarches pour créer mon entreprise ?",
      "Comment éviter un redressement fiscal ?",
      "Vos services sont-ils accessibles à une petite entreprise ?",
    ],
    appelTitre: "Parlons de votre situation.",
    appelChapeau: "Un rendez-vous, un appel ou un message : dites-nous où vous en êtes, nous vous dirons comment avancer.",
    rdv: "Prendre rendez-vous",
  },
  en: {
    titre: "Home",
    description: "Accounting firm in Abidjan: SYSCOHADA bookkeeping, tax and social security returns, payroll, FNE and financial advice for SMEs and entrepreneurs in Côte d'Ivoire.",
    etiquette: "Accounting firm · Abidjan",
    titreHero: "Your accounts in order, your horizon clear.",
    chapeau: "SYSCOHADA-compliant bookkeeping, tax and social security returns, payroll, financial advice: we support SMEs and entrepreneurs in Côte d'Ivoire so they can focus on their business.",
    ariaCompte: "What we take care of for you",
    servicesEtiquette: "Our services",
    servicesTitre: "What we take care of",
    services: [
      { titre: "Accounting and tax", texte: "SYSCOHADA-compliant bookkeeping, annual financial statements and tax returns." },
      { titre: "Payroll and HR administration", texte: "Payslips, contributions and CNPS returns, and follow-up of your employer obligations." },
      { titre: "Advisory and financial management", texte: "Cash flow, profitability, cost control and preparation of your financing applications." },
      { titre: "Audit and review", texte: "Review of your accounts and procedures, and calm preparation for a tax audit." },
      { titre: "Business set-up", texte: "Choice of legal structure, incorporation formalities and first administrative steps." },
      { titre: "Digitalisation and FNE", texte: "Setting up the standardised electronic invoice (FNE) and your management tools." },
    ],
    servicesLien: "See all our services",
    methodeEtiquette: "Our approach",
    methodeTitre: "From the first meeting to monthly follow-up",
    methodeChapeau: "Whether your books are up to date or several months behind, the path is the same.",
    etapes: [
      { titre: "A first conversation", texte: "You tell us about your situation, in a meeting, by phone or on WhatsApp." },
      { titre: "An initial review", texte: "We examine your documents and identify what needs to be regularised." },
      { titre: "Putting things in order", texte: "Books brought up to date, returns regularised, tools set up." },
      { titre: "Ongoing follow-up", texte: "Returns filed on time, figures tracked every month, advice to help you decide." },
    ],
    engagementsEtiquette: "Our commitments",
    engagementsTitre: "What you can count on",
    engagements: [
      { titre: "Compliance", texte: "Your accounts kept under SYSCOHADA, the accounting framework of the OHADA region." },
      { titre: "Confidentiality", texte: "Your figures and documents never leave the firm." },
      { titre: "Experience", texte: "Over 20 years of combined experience among our partners.", provisoire: true },
      { titre: "Responsiveness", texte: "A real person who answers you, including on WhatsApp." },
    ],
    questionsEtiquette: "Your questions",
    questionsTitre: "The ones we hear most often",
    questionsChapeau: "Tap a question: our assistant gives you a first answer, and the firm takes over for your specific case.",
    questions: [
      "What is the standardised electronic invoice (FNE)?",
      "How do I become compliant with the DGI and the CNPS?",
      "What are the steps to set up my company?",
      "How can I avoid a tax reassessment?",
      "Are your services affordable for a small business?",
    ],
    appelTitre: "Let's talk about your situation.",
    appelChapeau: "A meeting, a call or a message: tell us where you stand, and we'll tell you how to move forward.",
    rdv: "Book an appointment",
  },
}[langue];
---
<Base titre={textes.titre} description={textes.description} langue={langue} page="accueil" heroPhoto>
  <section class="hero">
    <div class="hero-fond" aria-hidden="true" style={`background-image: url("${photoHero(64)}&blur=40")`}>
      <img
        src={photoHero(2000)}
        srcset={[800, 1200, 1600, 2000, 2600].map((w) => `${photoHero(w)} ${w}w`).join(", ")}
        sizes="100vw"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="conteneur">
      <div class="hero-texte">
        <div>
          <p class="etiquette">{textes.etiquette}</p>
          <h1>{textes.titreHero}</h1>
        </div>
        <div class="hero-droite">
          <p class="chapeau">{textes.chapeau}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-compte" aria-label={textes.ariaCompte}>
    <div class="conteneur">
      <CompteEnT langue={langue} />
    </div>
  </section>

  <section class="bande bande-claire" aria-labelledby="titre-services">
    <div class="conteneur">
      <div class="entete-section">
        <p class="etiquette">{textes.servicesEtiquette}</p>
        <h2 id="titre-services">{textes.servicesTitre}</h2>
      </div>
      <ul class="services">
        {textes.services.map((s) => (
          <li>
            <h3>{s.titre}</h3>
            <p>{s.texte}</p>
          </li>
        ))}
      </ul>
      <a class="lien-fleche" href={url("services", langue)}>{textes.servicesLien}</a>
    </div>
  </section>

  <section class="bande" aria-labelledby="titre-methode">
    <div class="conteneur methode">
      <div class="entete-section">
        <p class="etiquette">{textes.methodeEtiquette}</p>
        <h2 id="titre-methode">{textes.methodeTitre}</h2>
        <p class="chapeau">{textes.methodeChapeau}</p>
      </div>
      <ol class="etapes">
        {textes.etapes.map((e, i) => (
          <li>
            <span class="numero" aria-hidden="true">{i + 1}</span>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bande bande-sombre" aria-labelledby="titre-engagements">
    <div class="conteneur">
      <div class="entete-section">
        <p class="etiquette">{textes.engagementsEtiquette}</p>
        <h2 id="titre-engagements">{textes.engagementsTitre}</h2>
      </div>
      <dl class="engagements">
        {textes.engagements.map((e) => (
          <div>
            <dt>{e.titre}</dt>
            <dd>{e.provisoire ? <span class="provisoire">{e.texte}</span> : e.texte}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bande" aria-labelledby="titre-questions">
    <div class="conteneur questions">
      <div class="entete-section">
        <p class="etiquette">{textes.questionsEtiquette}</p>
        <h2 id="titre-questions">{textes.questionsTitre}</h2>
        <p class="chapeau">{textes.questionsChapeau}</p>
      </div>
      <ul class="liste-questions">
        {textes.questions.map((q) => (
          <li><button type="button" data-question={q}>{q}<span aria-hidden="true">→</span></button></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bande bande-claire appel" aria-labelledby="titre-appel">
    <div class="conteneur appel-grille">
      <h2 id="titre-appel">{textes.appelTitre}</h2>
      <div>
        <p class="chapeau">{textes.appelChapeau}</p>
        <div class="actions">
          <a class="bouton bouton-plein" href={url("contact", langue, "#rendez-vous")}>{textes.rdv}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Héros : grande photo qui passe sous l'en-tête transparent */
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; align-items: flex-end;
    min-height: min(92svh, 880px);
    margin-top: calc(-1 * var(--hauteur-entete));
    padding-top: var(--hauteur-entete);
    background: var(--ebene);
    color: var(--papier);
  }
  .hero > .conteneur { width: min(var(--largeur), 100% - 2 * var(--gouttiere)); }
  /* La mini version floutée (fond) s'affiche tout de suite, la grande photo la recouvre dès qu'elle arrive */
  .hero-fond { position: absolute; inset: 0; z-index: -1; background-size: cover; background-position: 50% 58%; }
  .hero-fond img {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 58%;
    animation: recul 2.6s cubic-bezier(.2,.7,.2,1) both;
  }
  .hero-fond::after {
    content: ""; position: absolute; inset: 0;
    /* Voile dense seulement sous le texte (bas et gauche) et sous l'en-tête : le bureau reste lisible */
    background:
      linear-gradient(to top, rgba(36, 24, 15, 0.9) 0%, rgba(36, 24, 15, 0.62) 34%, rgba(36, 24, 15, 0) 60%),
      linear-gradient(100deg, rgba(36, 24, 15, 0.62) 0%, rgba(36, 24, 15, 0.18) 42%, rgba(36, 24, 15, 0) 62%),
      linear-gradient(to bottom, rgba(36, 24, 15, 0.5) 0%, rgba(36, 24, 15, 0) 20%);
  }
  @keyframes recul { from { transform: scale(1.07); } to { transform: scale(1); } }

  .hero-texte {
    display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(24px, 5vw, 72px);
    align-items: end; padding-block: clamp(120px, 18vh, 200px) clamp(48px, 8vw, 96px);
  }
  .hero-texte .etiquette { margin-bottom: 18px; color: var(--soleil); text-shadow: 0 1px 10px rgba(36, 24, 15, 0.95), 0 0 2px rgba(36, 24, 15, 0.8); }
  .hero h1 { max-width: 12ch; color: var(--papier); text-shadow: 0 2px 30px rgba(36, 24, 15, 0.35); }
  .hero-droite .chapeau { margin-bottom: 0; color: rgba(251, 245, 234, 0.92); text-shadow: 0 1px 14px rgba(36, 24, 15, 0.85), 0 0 2px rgba(36, 24, 15, 0.6); }

  .section-compte { padding-block: clamp(56px, 8vw, 104px); }
  /* Sur téléphone, la photo est recadrée en hauteur : on la centre sur la calculatrice et les graphiques */
  @media (max-width: 700px) {
    .hero-fond, .hero-fond img { object-position: 62% 50%; background-position: 62% 50%; }
  }

  .services { list-style: none; margin: 0 0 36px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 3px solid var(--ebene); }
  .services li { padding: 26px 26px 22px 0; border-bottom: 1px solid var(--trait); }
  .services li:not(:nth-child(3n + 1)) { padding-left: 26px; border-left: 1px solid var(--trait); }
  .services h3 { margin-bottom: 10px; }
  .services p { margin: 0; font-size: 1.02rem; color: #3D2B1E; }

  .lien-fleche { font: 620 1.05rem/1 var(--f-display); text-decoration: none; border-bottom: 2px solid var(--soleil); padding-bottom: 4px; }
  .lien-fleche::after { content: " →"; }

  .methode { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .etapes { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .etapes li { display: grid; grid-template-columns: 64px 1fr; column-gap: 18px; padding: 22px 0; border-top: 1px solid var(--trait); }
  .etapes li:last-child { border-bottom: 1px solid var(--trait); }
  .numero { grid-row: span 2; font: 760 2.6rem/1 var(--f-display); font-stretch: 80%; color: var(--soleil); -webkit-text-stroke: 1px var(--brun); }
  .etapes h3 { margin-bottom: 6px; }
  .etapes p { margin: 0; color: #3D2B1E; }

  .engagements { margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .engagements div { border-top: 2px solid var(--soleil); padding-top: 18px; }
  .engagements dt { font: 700 1.3rem/1.2 var(--f-display); font-stretch: 90%; margin-bottom: 10px; color: var(--papier); }
  .engagements dd { margin: 0; font-size: 1.02rem; color: var(--sable-fonce); }

  .questions { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .liste-questions { list-style: none; margin: 0; padding: 0; border-top: 3px solid var(--ebene); }
  .liste-questions li { border-bottom: 1px solid var(--trait); }
  .liste-questions button {
    width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 20px 4px; background: none; border: 0; cursor: pointer; text-align: left;
    font: 600 1.12rem/1.35 var(--f-texte); color: var(--ebene);
  }
  .liste-questions button span { font-family: var(--f-display); color: var(--olive); transition: transform .2s; }
  .liste-questions button:hover { color: var(--olive); }
  .liste-questions button:hover span { transform: translateX(4px); }

  .appel-grille { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: end; }
  .appel h2 { font-size: clamp(2.3rem, 5vw, 4rem); }
  .appel .chapeau { margin-bottom: 24px; }

  @media (max-width: 960px) {
    .hero-texte, .methode, .questions, .appel-grille { grid-template-columns: 1fr; }
    .services { grid-template-columns: 1fr 1fr; }
    .services li:not(:nth-child(3n + 1)) { padding-left: 0; border-left: 0; }
    .services li:nth-child(even) { padding-left: 22px; border-left: 1px solid var(--trait); }
    .engagements { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .services { grid-template-columns: 1fr; }
    .services li:nth-child(even) { padding-left: 0; border-left: 0; }
    .engagements { grid-template-columns: 1fr; gap: 24px; }
    .etapes li { grid-template-columns: 48px 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-question]").forEach((b) => {
    b.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("assistant:demander", { detail: b.dataset.question }));
    });
  });
</script>
