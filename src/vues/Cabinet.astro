---
import Base from "../layouts/Base.astro";
import { url, type Langue } from "../i18n";

interface Props { langue: Langue }
const { langue } = Astro.props;

// Texte d'ambition et objectifs fournis par M. Gnan (13/11/2026).
// PROVISOIRE : noms d'après la DFE, fonctions et photos à confirmer par le client.
const textes = {
  fr: {
    titre: "Le cabinet",
    description: "Horizon Comptable Afrique accompagne les entrepreneurs de Côte d'Ivoire dans la bonne gestion de leur activité : comptabilité SYSCOHADA, fiscalité, social et conseil.",
    etiquette: "Le cabinet",
    titrePage: "Mettre de l'ordre dans vos comptes, et rester à vos côtés.",
    chapeau: "Notre ambition : accompagner les entrepreneurs dans la bonne gestion de leurs activités, sécuriser leur situation financière et fiscale et contribuer durablement à leur croissance.",
    projetEtiquette: "Notre projet",
    projetTitre: "Ce que nous voulons pour chaque entreprise accompagnée",
    projetTexte: "Particuliers, entrepreneurs, PME : chacun mérite des comptes justes et une administration qui ne fait plus peur.",
    objectifs: [
      "Tenir une comptabilité fiable, régulière et conforme aux normes SYSCOHADA.",
      "Respecter leurs obligations fiscales et sociales et éviter les pénalités.",
      "Améliorer la gestion de leur trésorerie et maîtriser leurs charges.",
      "Disposer d'informations financières fiables pour prendre de meilleures décisions.",
      "Réduire les erreurs comptables et les risques de redressement fiscal.",
      "Digitaliser leurs outils de gestion pour gagner du temps et en efficacité.",
    ],
    equipeEtiquette: "L'équipe",
    equipeTitre: "Les associés",
    experience: "Plus de 20 ans d'expérience cumulée au service des entreprises.",
    equipe: [
      { initiales: "JG", nom: "Joël GNAN", fonction: "Gérant, comptable associé" },
      { initiales: "PM", nom: "Paul M'BODI ASSOMA", fonction: "Associé" },
    ],
    suiteTitre: "Faisons connaissance.",
    rdv: "Prendre rendez-vous",
    voirServices: "Voir nos services",
  },
  en: {
    titre: "The firm",
    description: "Horizon Comptable Afrique helps entrepreneurs in Côte d'Ivoire manage their business well: SYSCOHADA accounting, tax, payroll and advisory.",
    etiquette: "The firm",
    titrePage: "Putting your accounts in order, and staying by your side.",
    chapeau: "Our ambition: to support entrepreneurs in managing their business well, to secure their financial and tax position, and to contribute lastingly to their growth.",
    projetEtiquette: "Our mission",
    projetTitre: "What we want for every business we support",
    projetTexte: "Individuals, entrepreneurs, SMEs: everyone deserves accurate accounts and a tax administration that no longer feels intimidating.",
    objectifs: [
      "Keep reliable, regular accounts that comply with SYSCOHADA standards.",
      "Meet their tax and social security obligations and avoid penalties.",
      "Improve their cash management and keep their costs under control.",
      "Have reliable financial information to make better decisions.",
      "Reduce accounting errors and the risk of tax reassessment.",
      "Digitalise their management tools to save time and work more efficiently.",
    ],
    equipeEtiquette: "The team",
    equipeTitre: "The partners",
    experience: "Over 20 years of combined experience serving businesses.",
    equipe: [
      { initiales: "JG", nom: "Joël GNAN", fonction: "Managing Partner, accountant" },
      { initiales: "PM", nom: "Paul M'BODI ASSOMA", fonction: "Partner" },
    ],
    suiteTitre: "Let's get acquainted.",
    rdv: "Book an appointment",
    voirServices: "See our services",
  },
}[langue];
---
<Base titre={textes.titre} description={textes.description} langue={langue} page="cabinet">
  <section class="page-tete">
    <div class="conteneur">
      <p class="etiquette">{textes.etiquette}</p>
      <h1>{textes.titrePage}</h1>
      <p class="chapeau">{textes.chapeau}</p>
    </div>
  </section>

  <section class="bande" aria-labelledby="titre-projet">
    <div class="conteneur deux-colonnes">
      <div class="entete-section">
        <p class="etiquette">{textes.projetEtiquette}</p>
        <h2 id="titre-projet">{textes.projetTitre}</h2>
        <p>{textes.projetTexte}</p>
      </div>
      <ul class="pointage">
        {textes.objectifs.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </section>

  <section class="bande bande-claire" aria-labelledby="titre-equipe">
    <div class="conteneur">
      <div class="entete-section">
        <p class="etiquette">{textes.equipeEtiquette}</p>
        <h2 id="titre-equipe">{textes.equipeTitre}</h2>
        <p class="provisoire" style="display:inline-block">{textes.experience}</p>
      </div>
      <ul class="equipe">
        {textes.equipe.map((m) => (
          <li class="provisoire">
            <span class="portrait" aria-hidden="true">{m.initiales}</span>
            <div>
              <h3>{m.nom}</h3>
              <p>{m.fonction}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bande" aria-labelledby="titre-suite">
    <div class="conteneur suite">
      <h2 id="titre-suite">{textes.suiteTitre}</h2>
      <div class="actions">
        <a class="bouton bouton-plein" href={url("contact", langue, "#rendez-vous")}>{textes.rdv}</a>
        <a class="bouton bouton-contour" href={url("services", langue)}>{textes.voirServices}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .deux-colonnes { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .pointage { border-bottom: 1px solid var(--trait); font-size: 1.1rem; }

  .equipe { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 420px)); gap: 28px; }
  .equipe li { display: flex; gap: 20px; align-items: center; background: var(--papier); padding: 22px; border-radius: 14px; }
  .portrait {
    flex: none; width: 96px; height: 96px; border-radius: 50%;
    display: grid; place-items: center;
    background: radial-gradient(circle at 50% 120%, var(--soleil) 0 55%, var(--sable-fonce) 56%);
    font: 760 1.8rem/1 var(--f-display); color: var(--brun);
  }
  .equipe h3 { margin-bottom: 4px; }
  .equipe p { margin: 0; color: var(--brun); }

  .suite { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; }

  @media (max-width: 860px) {
    .deux-colonnes { grid-template-columns: 1fr; }
    .equipe { grid-template-columns: 1fr; }
  }
</style>
