---
import Base from "../layouts/Base.astro";
import { url, type Langue } from "../i18n";

interface Props { langue: Langue }
const { langue } = Astro.props;

// Les identifiants (ancres) restent les mêmes dans les deux langues.
const textes = {
  fr: {
    titre: "Services",
    description: "Comptabilité SYSCOHADA, fiscalité, paie et CNPS, conseil financier, audit, création d'entreprise et FNE : les services du cabinet Horizon Comptable Afrique à Abidjan.",
    etiquette: "Nos services",
    titrePage: "Tout ce qu'il faut pour des comptes en règle.",
    chapeau: "Prenez un service seul ou confiez-nous l'ensemble : nous adaptons notre accompagnement à la taille et au rythme de votre entreprise.",
    sommaireAria: "Accès direct aux services",
    services: [
      {
        id: "comptabilite", titre: "Comptabilité et fiscalité",
        texte: "Une comptabilité tenue chaque mois, des déclarations exactes et à l'heure : la base d'une entreprise sereine face à l'administration.",
        points: ["Tenue de la comptabilité selon le SYSCOHADA", "Saisie et classement de vos pièces justificatives", "États financiers annuels", "Déclarations fiscales périodiques et annuelles", "Reprise d'une comptabilité en retard"],
      },
      {
        id: "paie", titre: "Paie et gestion sociale",
        texte: "Vos salariés payés justement, vos cotisations déclarées : vous restez en règle avec la CNPS sans y passer vos soirées.",
        points: ["Bulletins de paie", "Calcul des cotisations sociales", "Déclarations CNPS", "Contrats de travail et formalités d'embauche", "Suivi de vos obligations d'employeur"],
      },
      {
        id: "conseil", titre: "Conseil et gestion financière",
        texte: "Des chiffres lisibles pour décider : où va votre argent, ce qui rapporte, ce qui coûte trop.",
        points: ["Suivi de trésorerie", "Analyse de la rentabilité", "Maîtrise des charges", "Tableaux de bord", "Préparation de vos dossiers de financement"],
      },
      {
        id: "audit", titre: "Audit et contrôle",
        texte: "Un regard extérieur sur vos comptes et vos procédures, avant qu'un contrôleur ne le fasse.",
        points: ["Revue de vos comptes", "Contrôle interne et procédures", "Diagnostic financier", "Préparation et accompagnement lors d'un contrôle fiscal"],
      },
      {
        id: "creation", titre: "Création d'entreprise",
        texte: "Partir du bon pied : la bonne forme juridique, des formalités bien faites et une comptabilité en place dès le premier jour.",
        points: ["Choix de la forme juridique", "Préparation des documents", "Formalités d'immatriculation et déclaration fiscale d'existence", "Mise en place de votre comptabilité"],
      },
      {
        id: "digitalisation", titre: "Digitalisation et FNE",
        texte: "La facture normalisée électronique et les logiciels de gestion, sans prise de tête : nous installons, vous gagnez du temps.",
        points: ["Mise en place de la facture normalisée électronique (FNE)", "Choix et paramétrage d'un logiciel comptable", "Organisation de la transmission de vos pièces", "Formation de vos équipes"],
      },
    ],
    appelEtiquette: "Un besoin précis ?",
    appelTitre: "Dites-nous où vous en êtes.",
    rdv: "Prendre rendez-vous",
  },
  en: {
    titre: "Services",
    description: "SYSCOHADA accounting, tax, payroll and CNPS, financial advisory, audit, business set-up and FNE: the services of Horizon Comptable Afrique in Abidjan.",
    etiquette: "Our services",
    titrePage: "Everything you need for accounts in good order.",
    chapeau: "Choose a single service or entrust us with everything: we adapt our support to the size and pace of your business.",
    sommaireAria: "Jump to a service",
    services: [
      {
        id: "comptabilite", titre: "Accounting and tax",
        texte: "Books kept every month, accurate returns filed on time: the foundation of a business that deals calmly with the tax authorities.",
        points: ["Bookkeeping under SYSCOHADA", "Recording and filing of your supporting documents", "Annual financial statements", "Periodic and annual tax returns", "Catching up on overdue accounts"],
      },
      {
        id: "paie", titre: "Payroll and HR administration",
        texte: "Your employees paid correctly, your contributions declared: you stay compliant with the CNPS without spending your evenings on it.",
        points: ["Payslips", "Calculation of social security contributions", "CNPS returns", "Employment contracts and hiring formalities", "Follow-up of your employer obligations"],
      },
      {
        id: "conseil", titre: "Advisory and financial management",
        texte: "Clear figures to make decisions: where your money goes, what pays off, what costs too much.",
        points: ["Cash-flow monitoring", "Profitability analysis", "Cost control", "Dashboards", "Preparation of your financing applications"],
      },
      {
        id: "audit", titre: "Audit and review",
        texte: "An outside look at your accounts and procedures, before a tax inspector takes one.",
        points: ["Review of your accounts", "Internal control and procedures", "Financial diagnosis", "Preparation and support during a tax audit"],
      },
      {
        id: "creation", titre: "Business set-up",
        texte: "Start on the right foot: the right legal structure, formalities done properly and accounting in place from day one.",
        points: ["Choice of legal structure", "Preparation of documents", "Registration formalities and tax declaration of existence", "Setting up your accounting"],
      },
      {
        id: "digitalisation", titre: "Digitalisation and FNE",
        texte: "The standardised electronic invoice and management software, without the headache: we set things up, you save time.",
        points: ["Setting up the standardised electronic invoice (FNE)", "Choosing and configuring accounting software", "Organising how your documents reach us", "Training your team"],
      },
    ],
    appelEtiquette: "A specific need?",
    appelTitre: "Tell us where you stand.",
    rdv: "Book an appointment",
  },
}[langue];
---
<Base titre={textes.titre} description={textes.description} langue={langue} page="services">
  <section class="page-tete">
    <div class="conteneur">
      <p class="etiquette">{textes.etiquette}</p>
      <h1>{textes.titrePage}</h1>
      <p class="chapeau">{textes.chapeau}</p>
      <nav class="sommaire" aria-label={textes.sommaireAria}>
        {textes.services.map((s) => <a href={`#${s.id}`}>{s.titre}</a>)}
      </nav>
    </div>
  </section>

  {textes.services.map((s, i) => (
    <section id={s.id} class:list={["bande", "service", { "bande-claire": i % 2 === 1 }]} aria-labelledby={`titre-${s.id}`}>
      <div class="conteneur service-grille">
        <div>
          <h2 id={`titre-${s.id}`}>{s.titre}</h2>
          <p class="chapeau">{s.texte}</p>
        </div>
        <ul class="pointage">
          {s.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </section>
  ))}

  <section class="bande bande-sombre" aria-labelledby="titre-appel">
    <div class="conteneur appel">
      <div>
        <p class="etiquette">{textes.appelEtiquette}</p>
        <h2 id="titre-appel">{textes.appelTitre}</h2>
      </div>
      <div class="actions">
        <a class="bouton bouton-plein" href={url("contact", langue, "#rendez-vous")}>{textes.rdv}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .sommaire { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .sommaire a {
    font: 560 0.92rem/1 var(--f-display); text-decoration: none;
    padding: 10px 14px; border: 1px solid var(--trait); border-radius: 999px; background: var(--papier);
  }
  .sommaire a:hover { border-color: var(--olive); }
  .service { scroll-margin-top: 80px; padding-block: clamp(48px, 7vw, 88px); }
  .service-grille { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(28px, 6vw, 80px); align-items: start; }
  .service h2 { margin-bottom: 16px; }
  .pointage { border-bottom: 1px solid var(--trait); }
  .appel { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 28px; }
  .appel h2 { margin-top: 12px; }
  @media (max-width: 860px) { .service-grille { grid-template-columns: 1fr; } }
</style>
